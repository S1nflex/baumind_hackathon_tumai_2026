# Full AI + market analysis is blocked until an AI provider and at least one market source are configured.
# Local-only import, parsing and calculations still work without keys.
SERPAPI_API_KEY=455eb85a7aa27b421cd8d4682dde399d99e19c3a142239960dd92a446a1b9a5d
ANTHROPIC_API_KEY=
# Set to a model available to your Anthropic API account.
ANTHROPIC_MODEL=
OPENAI_API_KEY=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
# Optional; defaults to gpt-5-mini when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-5-mini
# Optional server-only market price storage. Never prefix secret keys with NEXT_PUBLIC_.
SUPABASE_URL=https://ukoqxwtahjaocbxcfvss.supabase.co
SUPABASE_SECRET_KEY=sb_secret_wxyjSTn-5m9m8T8oK_RrNA_rdnqoNIw
# Protects POST/GET /api/cron/scrape-prices.
CRON_SECRET=a347c56beb92a91d5cb99f65664ecbf26a237510bde56f13680a62596ddb13f5
# Optional absolute SQLite location. Default: .data/bauton.sqlite
BAUTON_DB=
# Use a separate SQLite file and serve over HTTPS for a shareable browser-isolated preview.
BAUTON_PREVIEW=0

# Preferred BauMind env variables (old BAUTON_* names remain supported).
BAUMIND_DB=
BAUMIND_PREVIEW=0
# Production is fail-closed unless preview isolation is enabled. Set only on a private, single-user deployment.
BAUMIND_SINGLE_USER=0

# Integration setup: copy .env.example to .env.local and fill SERVER-ONLY values.
# Never commit .env.local or a Supabase secret/service-role key.
# Supabase project URL and secret are sufficient for the REST price catalog;
# PostgreSQL database username/password are NOT needed for this integration.
# Only import uploads with AI enabled send text to an external AI provider.

# Limit AI indicative estimates to avoid unexpected provider charges (1..200).
BAUMIND_MAX_AI_MARKET_ROWS=60
# Generate a private local settings token with: npm run setup:integrations
# BAUMIND_SETTINGS_TOKEN is stored in .env.local, never here.

# Optional AI provider preference; OpenAI is used first by default for both chat and market pricing.
BAUMIND_AI_PROVIDER=openai
# Live Google Shopping requests per position (1..3). More requests can consume SerpAPI credits.
BAUMIND_MAX_SERP_QUERIES_PER_POSITION=2
