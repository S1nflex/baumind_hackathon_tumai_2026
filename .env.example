# Optional. Local parsing, review, calculations and export work without keys.
SERPAPI_API_KEY=
OPENAI_API_KEY=
# Optional model override. Default: gpt-5-mini
OPENAI_MODEL=
# Optional absolute SQLite location. Default: .data/bauton.sqlite
BAUTON_DB=
# Use a separate SQLite file and serve over HTTPS for a shareable browser-isolated preview.
BAUTON_PREVIEW=0

# Supabase server-side market-price storage. The service role key must never be exposed to browsers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
CRON_SECRET=
