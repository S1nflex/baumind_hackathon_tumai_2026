# Optional. Local parsing, review, calculations and export work without keys.
SERPAPI_API_KEY=
ANTHROPIC_API_KEY=
# Set to a model available to your Anthropic API account.
ANTHROPIC_MODEL=
# Optional absolute SQLite location. Default: .data/bauton.sqlite
BAUTON_DB=
# Use a separate SQLite file and serve over HTTPS for a shareable browser-isolated preview.
BAUTON_PREVIEW=0

# Preferred BauMind env variables (old BAUTON_* names remain supported).
BAUMIND_DB=
BAUMIND_PREVIEW=0
