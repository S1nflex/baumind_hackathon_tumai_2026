{
  "name": "baumind",
  "version": "1.0.0",
  "description": "BauMind · Naturverbundene, intelligente Baukalkulation",
  "scripts": {
    "test": "node --import=tsx --test test/*.test.ts && node --test test/integration-ui-regression.test.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "scrape:prices": "node --env-file-if-exists=.env.local --import=tsx scripts/scrape-prices.ts",
    "setup:pdf": "bash scripts/setup-pdf-import.sh",
    "setup:ocr": "bash scripts/setup-pdf-ocr.sh",
    "doctor": "node scripts/doctor.mjs",
    "verify": "npm run doctor && npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "setup:integrations": "node scripts/setup-integrations.mjs",
    "test:integration-ui": "node --test test/integration-ui-regression.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.143",
    "@ai-sdk/openai": "^3.0.144",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "ai": "^6.0.333",
    "cheerio": "^1.2.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
